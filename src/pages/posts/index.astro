---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const publishedPosts = allPosts
  .filter((post) => !post.data.draft && post.data.date)
  .sort((a, b) => new Date(b.data.date!).getTime() - new Date(a.data.date!).getTime());

// Collect all unique categories
const categoriesSet = new Set<string>();
publishedPosts.forEach((post) => {
  if (post.data.categories) {
    post.data.categories.forEach((cat) => categoriesSet.add(cat));
  }
});
const categories = Array.from(categoriesSet).sort();
---

<BaseLayout title="Blog" description="Articles and analysis on BigQuery, data platforms, and product management by Max Ostapenko">
  <div class="container">
    <div class="posts-page-header">
      <h1 class="page-title">Blog</h1>
      <p class="page-lead">
        Articles, hands-on tutorials, and experiments on BigQuery, AdTech, and data engineering.
      </p>

      {categories.length > 0 && (
        <div class="category-filters">
          <span class="filter-label">Categories:</span>
          {categories.map((cat) => (
            <a href={`/posts/category/${cat.toLowerCase().replace(/\s+/g, '-')}/`} class="category-filter-btn">
              {cat}
            </a>
          ))}
        </div>
      )}
    </div>

    <div class="posts-list">
      {publishedPosts.map((post) => {
        const slug = post.id.replace(/\/index$/, '');
        const formattedDate = new Date(post.data.date!).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          timeZone: 'UTC'
        });

        return (
          <article class="post-list-item">
            <div class="post-item-meta">
              <time datetime={new Date(post.data.date!).toISOString()}>{formattedDate}</time>
            </div>
            <div class="post-item-content">
              <h2 class="post-item-title">
                <a href={`/posts/${slug}/`}>{post.data.title}</a>
              </h2>
              {post.data.description && (
                <p class="post-item-desc">{post.data.description}</p>
              )}
              {post.data.categories && post.data.categories.length > 0 && (
                <div class="post-item-tags">
                  {post.data.categories.map((cat) => (
                    <a href={`/posts/category/${cat.toLowerCase().replace(/\s+/g, '-')}/`} class="item-tag">
                      {cat}
                    </a>
                  ))}
                </div>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .posts-page-header {
    padding: 3rem 0 2rem 0;
    border-bottom: 1px solid var(--color-border-light);
    margin-bottom: 2rem;
  }

  .page-title {
    font-size: 2.4rem;
    margin-bottom: 0.5rem;
  }

  .page-lead {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .category-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .filter-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .category-filter-btn {
    display: inline-block;
    padding: 3px 10px;
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    border-radius: 20px;
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    transition: var(--transition);
  }

  .category-filter-btn:hover {
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    border-color: var(--color-accent);
    text-decoration: none;
  }

  /* Post List */
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-bottom: 4rem;
  }

  .post-list-item {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border-light);
  }

  .post-item-meta {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    padding-top: 0.2rem;
  }

  .post-item-title {
    font-size: 1.45rem;
    line-height: 1.35;
    margin: 0 0 0.5rem 0;
    border: none;
    padding: 0;
  }

  .post-item-title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .post-item-title a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .post-item-desc {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }

  .post-item-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .item-tag {
    font-size: 0.78rem;
    color: var(--color-primary);
    background-color: var(--color-primary-light);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-weight: 500;
  }

  .item-tag:hover {
    background-color: var(--color-primary);
    color: #ffffff;
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .post-list-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
