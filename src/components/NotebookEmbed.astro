---
import { parseNotebook } from '../lib/notebookParser';

interface Props {
  path: string;
  cell?: string;
  echo?: boolean;
  codeFold?: boolean;
}

const { path: notebookPath, cell: targetCell, echo = true, codeFold = true } = Astro.props;

const cells = parseNotebook(notebookPath, targetCell);
---

<div class="notebook-embed-wrapper">
  {cells.map((c) => (
    <div class="notebook-cell" id={c.id ? `cell-${c.id}` : undefined}>
      {c.type === 'markdown' ? (
        <div class="notebook-markdown prose" set:html={c.htmlContent || c.source} />
      ) : (
        <div class="notebook-code-cell">
          {echo && (
            codeFold ? (
              <details class="notebook-code-details" open>
                <summary class="notebook-code-summary">
                  <span class="summary-text">Show / Hide Code</span>
                </summary>
                <pre class="notebook-code-block"><code>{c.source}</code></pre>
              </details>
            ) : (
              <pre class="notebook-code-block"><code>{c.source}</code></pre>
            )
          )}
          {c.outputs && c.outputs.length > 0 && (
            <div class="notebook-outputs">
              {c.outputs.map((out) => (
                <div class={`notebook-output-item output-${out.type}`}>
                  {out.type === 'html' || out.type === 'image' ? (
                    <div set:html={out.content} />
                  ) : (
                    <pre class="notebook-stream-output"><code>{out.content}</code></pre>
                  )}
                </div>
              ))}
            </div>
          )}
        </div>
      )}
    </div>
  ))}
</div>

<style>
  .notebook-embed-wrapper {
    margin: 1.5rem 0;
  }

  .notebook-cell {
    margin-bottom: 1.25rem;
  }

  .notebook-markdown {
    margin: 1rem 0;
  }

  .notebook-markdown :global(h1),
  .notebook-markdown :global(h2),
  .notebook-markdown :global(h3),
  .notebook-markdown :global(h4) {
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .notebook-markdown :global(p) {
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }

  .notebook-markdown :global(ul),
  .notebook-markdown :global(ol) {
    margin: 0.5rem 0 1rem 1.5rem;
  }

  .notebook-markdown :global(li) {
    margin-bottom: 0.25rem;
  }

  .notebook-markdown :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .notebook-markdown :global(code) {
    background-color: var(--color-bg-subtle);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.88em;
    font-family: var(--font-mono);
  }

  .notebook-code-details {
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: 0.75rem;
  }

  .notebook-code-summary {
    padding: 0.4rem 0.85rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-muted);
    cursor: pointer;
    background-color: rgba(0, 0, 0, 0.02);
    user-select: none;
  }

  .notebook-code-summary:hover {
    color: var(--color-primary);
  }

  .notebook-code-block {
    margin: 0 !important;
    border-radius: 0 !important;
  }

  .notebook-outputs {
    margin-top: 0.5rem;
  }

  .notebook-stream-output {
    background-color: #f6f8fa !important;
    color: #24292f;
    border: 1px solid var(--color-border);
    padding: 0.6rem 0.85rem;
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
    overflow-x: auto;
    white-space: pre;
    word-break: normal;
  }

  .output-html table {
    font-size: 0.85rem;
    margin: 0.5rem 0;
  }
</style>
