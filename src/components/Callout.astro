---
interface Props {
  type?: 'note' | 'tip' | 'warning' | 'caution' | 'important';
  title?: string;
}

const { type = 'note', title } = Astro.props;

const calloutConfig = {
  note: {
    label: title || 'Note',
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>`,
    colorClass: 'callout-note'
  },
  tip: {
    label: title || 'Tip',
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M9 21c0 .55.45 1 1 1h4c.55 0 1-.45 1-1v-1H9v1zm3-19C8.14 2 5 5.14 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.86-3.14-7-7-7z"/></svg>`,
    colorClass: 'callout-tip'
  },
  warning: {
    label: title || 'Warning',
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/></svg>`,
    colorClass: 'callout-warning'
  },
  caution: {
    label: title || 'Caution',
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>`,
    colorClass: 'callout-caution'
  },
  important: {
    label: title || 'Important',
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>`,
    colorClass: 'callout-important'
  }
};

const config = calloutConfig[type] || calloutConfig.note;
---

<div class={`callout-box ${config.colorClass}`}>
  <div class="callout-header">
    <span class="callout-icon" set:html={config.icon} />
    <span class="callout-title">{config.label}</span>
  </div>
  <div class="callout-content">
    <slot />
  </div>
</div>

<style>
  .callout-box {
    border-radius: var(--radius-md);
    margin: 1.5rem 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background-color: var(--color-bg-subtle);
    box-shadow: var(--shadow-sm);
  }

  .callout-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0.6rem 1rem;
    font-weight: 600;
    font-size: 0.95rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  .callout-content {
    padding: 0.85rem 1rem;
    font-size: 0.95rem;
  }

  .callout-content :global(p:last-child) {
    margin-bottom: 0;
  }

  /* Theme variants */
  .callout-note {
    border-color: rgba(26, 115, 232, 0.3);
    background-color: #f8fbff;
  }
  .callout-note .callout-header {
    color: #174ea6;
    background-color: rgba(26, 115, 232, 0.08);
  }

  .callout-tip {
    border-color: rgba(52, 168, 83, 0.3);
    background-color: #f6fdf8;
  }
  .callout-tip .callout-header {
    color: #137333;
    background-color: rgba(52, 168, 83, 0.08);
  }

  .callout-warning {
    border-color: rgba(249, 171, 0, 0.4);
    background-color: #fefcf5;
  }
  .callout-warning .callout-header {
    color: #b06000;
    background-color: rgba(249, 171, 0, 0.1);
  }

  .callout-caution,
  .callout-important {
    border-color: rgba(234, 67, 53, 0.3);
    background-color: #fef8f8;
  }
  .callout-caution .callout-header,
  .callout-important .callout-header {
    color: #c5221f;
    background-color: rgba(234, 67, 53, 0.08);
  }
</style>
