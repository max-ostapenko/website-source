---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="tab-panel" data-label={label} role="tabpanel">
  <slot />
</div>

<style>
  .tab-panel {
    animation: fadeIn 0.15s ease-in-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .tab-panel :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
