---
---

<div class="region-locator-dashboard">
  <!-- Sidebar -->
  <aside class="dashboard-sidebar">
    <div class="sidebar-header">
      <h2 class="sidebar-title">GCP Regions</h2>
      <div class="sidebar-legend">
        <span class="legend-item"><span class="marker-dot precise"></span> Precise</span>
        <span class="legend-item"><span class="marker-dot approximate"></span> Approximate</span>
      </div>
    </div>
    <div id="region-list" class="region-list-container">
      <div class="loading-state">Loading regions data...</div>
    </div>
  </aside>

  <!-- Map Container -->
  <main class="dashboard-map-wrapper">
    <div class="map-controls">
      <button id="satellite-btn" class="map-btn active" type="button">Satellite</button>
      <button id="street-btn" class="map-btn" type="button">Street</button>
    </div>
    <div id="leaflet-map" class="leaflet-map-canvas"></div>
  </main>
</div>

<!-- Toast notification container -->
<div id="toast-notification" class="toast-notification" aria-live="polite"></div>

<!-- Leaflet CDN -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<style>
  .region-locator-dashboard {
    display: grid;
    grid-template-columns: 320px 1fr;
    height: calc(100vh - 120px);
    min-height: 600px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin: 1rem 0 2rem 0;
    box-shadow: var(--shadow-md);
    background: #ffffff;
  }

  /* Sidebar */
  .dashboard-sidebar {
    background-color: #ffffff;
    border-right: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .sidebar-header {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--color-border-light);
    background-color: var(--color-bg-subtle);
  }

  .sidebar-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 0.5rem 0;
    border: none;
    padding: 0;
  }

  .sidebar-legend {
    display: flex;
    gap: 12px;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .marker-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }
  .marker-dot.precise { background-color: #34a853; }
  .marker-dot.approximate { background-color: #fbbc04; }

  .region-list-container {
    flex: 1;
    overflow-y: auto;
    padding: 0.5rem 0.75rem;
  }

  .loading-state {
    padding: 2rem;
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  /* Map */
  .dashboard-map-wrapper {
    position: relative;
    height: 100%;
    width: 100%;
  }

  .leaflet-map-canvas {
    height: 100%;
    width: 100%;
    z-index: 1;
  }

  .map-controls {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 1000;
    background: #ffffff;
    border-radius: var(--radius-sm);
    box-shadow: 0 2px 6px rgba(0,0,0,0.3);
    overflow: hidden;
    display: flex;
  }

  .map-btn {
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 500;
    border: none;
    cursor: pointer;
    background: #ffffff;
    color: #333333;
    border-right: 1px solid var(--color-border-light);
    transition: var(--transition);
  }

  .map-btn:last-child {
    border-right: none;
  }

  .map-btn.active {
    background-color: var(--color-primary);
    color: #ffffff;
  }

  /* Region Item Styles (injected via JS) */
  :global(.continent-header) {
    margin-top: 14px;
    margin-bottom: 4px;
    cursor: pointer;
  }

  :global(.continent-title) {
    font-size: 12px;
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0;
    border: none;
  }

  :global(.continent-title:hover) {
    background-color: var(--color-bg-subtle);
  }

  :global(.continent-toggle) {
    font-size: 10px;
    transition: transform 0.2s ease;
  }

  :global(.continent-toggle.expanded) {
    transform: rotate(90deg);
  }

  :global(.continent-regions) {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(.continent-regions.expanded) {
    grid-template-rows: 1fr;
  }

  :global(.continent-regions-inner) {
    overflow: hidden;
  }

  :global(.region-item) {
    cursor: pointer;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    margin-bottom: 3px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: var(--transition);
  }

  :global(.region-item:hover) {
    background-color: var(--color-bg-subtle);
  }

  :global(.region-item.active) {
    background-color: var(--color-primary-light);
    color: var(--color-primary);
  }

  :global(.region-text-main) {
    font-weight: 600;
    font-size: 13px;
    margin: 0;
    line-height: 1.2;
  }

  :global(.region-text-sub) {
    font-size: 11px;
    color: var(--color-text-muted);
    margin: 2px 0 0 0;
    line-height: 1.2;
  }

  :global(.region-actions) {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  :global(.region-marker-badge) {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid #ffffff;
    box-shadow: 0 1px 2px rgba(0,0,0,0.3);
  }
  :global(.region-marker-badge.precise) { background-color: #34a853; }
  :global(.region-marker-badge.approximate) { background-color: #fbbc04; }

  :global(.copy-link-btn) {
    background: none;
    border: none;
    cursor: pointer;
    padding: 3px;
    color: var(--color-text-muted);
    border-radius: 3px;
    opacity: 0;
    transition: var(--transition);
  }

  :global(.region-item:hover .copy-link-btn),
  :global(.region-item.active .copy-link-btn) {
    opacity: 1;
  }

  :global(.copy-link-btn:hover) {
    background-color: rgba(0,0,0,0.06);
    color: var(--color-primary);
  }

  /* Toast Notification */
  .toast-notification {
    position: fixed;
    bottom: 24px;
    left: 24px;
    background: #323232;
    color: #ffffff;
    padding: 10px 18px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    box-shadow: var(--shadow-lg);
    z-index: 10000;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.25s ease;
    pointer-events: none;
  }

  .toast-notification.show {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 860px) {
    .region-locator-dashboard {
      grid-template-columns: 1fr;
      height: 800px;
    }
    .dashboard-sidebar {
      max-height: 300px;
    }
  }
</style>

<script>
  declare const L: any;

  interface GcpRegion {
    id: string;
    locationName: string;
    lat: number;
    lng: number;
    approximate?: boolean;
  }

  let gcpRegions: GcpRegion[] = [];
  let map: any = null;
  const markers: Record<string, any> = {};
  let activeRegionId: string | null = null;
  let satelliteLabelsLayer: any = null;
  let streetLayer: any = null;

  function showToast(message: string) {
    const toast = document.getElementById('toast-notification');
    if (!toast) return;
    toast.textContent = message;
    toast.classList.add('show');
    setTimeout(() => {
      toast.classList.remove('show');
    }, 2000);
  }

  function copyRegionLink(regionId: string) {
    const url = `${window.location.origin}${window.location.pathname}#region=${regionId}`;
    navigator.clipboard.writeText(url).then(() => {
      showToast('Direct link copied to clipboard');
    });
  }

  function getRegionFromURL(): string | null {
    return window.location.hash.startsWith('#region=') ? window.location.hash.substring(8) : null;
  }

  function updateURL(regionId: string) {
    history.replaceState(null, '', regionId ? `#region=${regionId}` : window.location.pathname);
  }

  async function loadRegionsData() {
    try {
      const res = await fetch('/static/data/gcp-regions.json');
      gcpRegions = await res.json();
    } catch (e) {
      console.error('Failed to load regions data:', e);
      gcpRegions = [];
    }
  }

  function getContinent(regionId: string): string {
    if (regionId.startsWith('asia-')) return 'Asia';
    if (regionId.startsWith('europe-')) return 'Europe';
    if (regionId.startsWith('us-') || regionId.startsWith('northamerica-')) return 'North America';
    if (regionId.startsWith('southamerica-')) return 'South America';
    if (regionId.startsWith('australia-')) return 'Australia & Oceania';
    if (regionId.startsWith('me-')) return 'Middle East';
    if (regionId.startsWith('africa-')) return 'Africa';
    return 'Other';
  }

  function setActiveRegion(regionId: string, updateState = true) {
    if (activeRegionId) {
      const prev = document.querySelector(`.region-item[data-region-id="${activeRegionId}"]`);
      prev?.classList.remove('active');
    }
    const current = document.querySelector(`.region-item[data-region-id="${regionId}"]`);
    current?.classList.add('active');

    if (current) {
      const regionsContainer = current.closest('.continent-regions');
      if (regionsContainer && !regionsContainer.classList.contains('expanded')) {
        const header = regionsContainer.previousElementSibling;
        const toggle = header?.querySelector('.continent-toggle');
        regionsContainer.classList.add('expanded');
        toggle?.classList.add('expanded');
      }
    }

    activeRegionId = regionId;
    if (updateState) updateURL(regionId);
  }

  function populateRegionList() {
    const container = document.getElementById('region-list');
    if (!container) return;
    container.innerHTML = '';

    const grouped: Record<string, GcpRegion[]> = {};
    gcpRegions.forEach((r) => {
      const c = getContinent(r.id);
      if (!grouped[c]) grouped[c] = [];
      grouped[c].push(r);
    });

    const order = ['Africa', 'Asia', 'Australia & Oceania', 'Europe', 'Middle East', 'North America', 'South America', 'Other'];

    order.filter((c) => grouped[c]).forEach((c) => {
      const head = document.createElement('div');
      head.className = 'continent-header';
      head.innerHTML = `
        <h3 class="continent-title">
          <span>${c}</span>
          <span class="continent-toggle">▶</span>
        </h3>
      `;

      const regionsContainer = document.createElement('div');
      regionsContainer.className = 'continent-regions';

      const regionsInner = document.createElement('div');
      regionsInner.className = 'continent-regions-inner';
      regionsContainer.appendChild(regionsInner);

      head.addEventListener('click', () => {
        const toggle = head.querySelector('.continent-toggle');
        const isExpanded = regionsContainer.classList.contains('expanded');
        if (isExpanded) {
          regionsContainer.classList.remove('expanded');
          toggle?.classList.remove('expanded');
        } else {
          regionsContainer.classList.add('expanded');
          toggle?.classList.add('expanded');
        }
      });

      container.appendChild(head);
      container.appendChild(regionsContainer);

      grouped[c].sort((a, b) => a.id.localeCompare(b.id)).forEach((region) => {
        const item = document.createElement('div');
        item.className = `region-item${region.approximate ? ' approximate' : ''}`;
        item.dataset.regionId = region.id;

        item.innerHTML = `
          <div style="flex:1;">
            <p class="region-text-main">${region.id}</p>
            <p class="region-text-sub">${region.locationName}</p>
          </div>
          <div class="region-actions">
            <button class="copy-link-btn" title="Copy direct link" type="button">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/>
              </svg>
            </button>
            <div class="region-marker-badge ${region.approximate ? 'approximate' : 'precise'}" title="${region.approximate ? 'Approximate location' : 'Precise location'}"></div>
          </div>
        `;

        const copyBtn = item.querySelector('.copy-link-btn');
        copyBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          copyRegionLink(region.id);
        });

        item.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('.copy-link-btn')) return;
          setActiveRegion(region.id);
          map?.setView([region.lat, region.lng], 12);
        });

        regionsInner.appendChild(item);
      });
    });
  }

  function setupMapControls() {
    const satelliteBtn = document.getElementById('satellite-btn');
    const streetBtn = document.getElementById('street-btn');
    if (!satelliteBtn || !streetBtn || !map) return;

    satelliteBtn.addEventListener('click', () => {
      if (map.hasLayer(streetLayer)) map.removeLayer(streetLayer);
      if (!map.hasLayer(satelliteLabelsLayer)) map.addLayer(satelliteLabelsLayer);
      satelliteBtn.className = 'map-btn active';
      streetBtn.className = 'map-btn';
    });

    streetBtn.addEventListener('click', () => {
      if (map.hasLayer(satelliteLabelsLayer)) map.removeLayer(satelliteLabelsLayer);
      if (!map.hasLayer(streetLayer)) map.addLayer(streetLayer);
      streetBtn.className = 'map-btn active';
      satelliteBtn.className = 'map-btn';
    });
  }

  async function initMap() {
    await loadRegionsData();
    const mapContainer = document.getElementById('leaflet-map');
    if (!mapContainer || typeof L === 'undefined') return;

    map = L.map(mapContainer.id, { zoomControl: true, attributionControl: true }).setView([20, 0], 2);

    satelliteLabelsLayer = L.layerGroup([
      L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
        attribution: '© Esri',
        maxZoom: 18,
      }),
      L.tileLayer('https://{s}.basemaps.cartocdn.com/light_only_labels/{z}/{x}/{y}{r}.png', {
        attribution: '© CartoDB, © OpenStreetMap',
        maxZoom: 19,
        subdomains: 'abcd',
      }),
    ]).addTo(map);

    streetLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap contributors',
      maxZoom: 19,
    });

    gcpRegions.forEach((region) => {
      const marker = L.circleMarker([region.lat, region.lng], {
        radius: 6,
        fillColor: region.approximate ? '#fbbc04' : '#34a853',
        color: '#ffffff',
        weight: 2,
        fillOpacity: region.approximate ? 0.8 : 0.9,
      }).addTo(map);

      marker.bindPopup(`
        <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 13px; min-width: 180px;">
          <strong style="color: #174EA6; font-size: 15px;">${region.id}</strong><br/>
          <span style="color: #5f6368;">${region.locationName}</span>
          ${region.approximate ? '<br/><span style="color:#b06000;font-size:11px;">⚠️ Approximate coordinates</span>' : ''}
        </div>
      `);

      markers[region.id] = marker;
      marker.on('click', () => {
        setActiveRegion(region.id);
        map.setView([region.lat, region.lng], 12);
      });
    });

    populateRegionList();
    setupMapControls();

    const target = getRegionFromURL();
    if (target) {
      const region = gcpRegions.find((r) => r.id === target);
      if (region) {
        map.setView([region.lat, region.lng], 12);
        setActiveRegion(region.id, false);
      }
    }

    setTimeout(() => map.invalidateSize(true), 300);
  }

  document.addEventListener('DOMContentLoaded', initMap);
  window.addEventListener('hashchange', () => {
    const target = getRegionFromURL();
    if (!target) return;
    const region = gcpRegions.find((r) => r.id === target);
    if (region && map) {
      map.setView([region.lat, region.lng], 12);
      setActiveRegion(region.id, false);
    }
  });
</script>
