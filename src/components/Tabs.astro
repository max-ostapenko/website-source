---
---

<div class="tabs-container">
  <div class="tabs-header" role="tablist">
    <!-- Tab buttons will be dynamically activated via script -->
  </div>
  <div class="tabs-panels">
    <slot />
  </div>
</div>

<style>
  .tabs-container {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    margin: 1.5rem 0;
    overflow: hidden;
    background: #ffffff;
  }

  .tabs-header {
    display: flex;
    background-color: var(--color-bg-subtle);
    border-bottom: 1px solid var(--color-border);
    overflow-x: auto;
  }

  :global(.tab-button) {
    padding: 0.65rem 1.25rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-muted);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition: var(--transition);
    white-space: nowrap;
  }

  :global(.tab-button:hover) {
    color: var(--color-primary);
    background-color: rgba(0,0,0,0.02);
  }

  :global(.tab-button.active) {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
    background-color: #ffffff;
    font-weight: 600;
  }

  .tabs-panels {
    padding: 1.25rem;
  }
</style>

<script>
  function setupTabs() {
    const containers = document.querySelectorAll('.tabs-container');
    containers.forEach((container) => {
      if (container.getAttribute('data-initialized')) return;
      container.setAttribute('data-initialized', 'true');

      const header = container.querySelector('.tabs-header');
      const panels = container.querySelectorAll('.tab-panel');
      if (!header || panels.length === 0) return;

      panels.forEach((panel, index) => {
        const label = panel.getAttribute('data-label') || `Tab ${index + 1}`;
        const btn = document.createElement('button');
        btn.className = `tab-button ${index === 0 ? 'active' : ''}`;
        btn.textContent = label;
        btn.setAttribute('role', 'tab');
        btn.setAttribute('aria-selected', index === 0 ? 'true' : 'false');

        if (index !== 0) {
          (panel as HTMLElement).style.display = 'none';
        }

        btn.addEventListener('click', () => {
          header.querySelectorAll('.tab-button').forEach((b) => {
            b.classList.remove('active');
            b.setAttribute('aria-selected', 'false');
          });
          panels.forEach((p) => ((p as HTMLElement).style.display = 'none'));

          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');
          (panel as HTMLElement).style.display = 'block';
        });

        header.appendChild(btn);
      });
    });
  }

  document.addEventListener('DOMContentLoaded', setupTabs);
</script>
